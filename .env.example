# Copy to repo-root `.env` (gitignored). Never commit `.env`.
#   cp .env.example .env
# Talos and pytest fill missing keys from `.env` (strip quotes; skip blank and #).
# Order: CLI flags > process env > `.env` > `azd env get-values` (unless --no-azd).
# After `azd up`, paste `azd env get-values` into `.env`, or fill from portal outputs.
# Canonical names only. Do not set SEARCH_ENDPOINT or FOUNDRY_PROJECT_ENDPOINT.
# Auth is Microsoft Entra ID / DefaultAzureCredential (`az login`). Keys may exist
# on the resource; do not put them here unless generate-only connection string.

# Required for `uv run talos deploy` (exit 2 if missing).
AZURE_SEARCH_ENDPOINT=https://srch-cp-<token>.search.windows.net
AZURE_AI_PROJECT_ENDPOINT=https://aif-cp-<token>.services.ai.azure.com/api/projects/credit-policy-demo
AZURE_AI_PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/rg-credit-policy-<env>/providers/Microsoft.CognitiveServices/accounts/aif-cp-<token>/projects/credit-policy-demo
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/rg-credit-policy-<env>/providers/Microsoft.Storage/storageAccounts/stcp<token>
AZURE_AI_SERVICES_ENDPOINT=https://aif-cp-<token>.services.ai.azure.com

# Bicep outputs. Generate uses AZURE_STORAGE_ACCOUNT_URL with DefaultAzureCredential.
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-credit-policy-<env>
AZURE_STORAGE_ACCOUNT_URL=https://stcp<token>.blob.core.windows.net
AZURE_AI_PROJECT_PRINCIPAL_ID=

# Optional. Generate-only. Never commit a real connection string.
# AZURE_STORAGE_CONNECTION_STRING=

# Optional. Teams live tests skip unless set to 1 (T8).
# E2E_TEAMS=1
