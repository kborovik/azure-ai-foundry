{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientApplication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "application_type",
    "expected_judgement",
    "expected_policy_ids",
    "customer_name",
    "customer_id",
    "email",
    "phone",
    "address",
    "age_band",
    "employer",
    "annual_income",
    "product",
    "facility",
    "narrative",
    "missing_items"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "pattern": "^CA-(ACCEPTED|REJECTED|MISSING-DATA)-[0-9]{4}-[0-9]{2}$"
    },
    "application_type": {
      "type": "string",
      "enum": ["accepted", "rejected", "missing-data"]
    },
    "expected_judgement": {
      "type": "string",
      "enum": ["accepted", "rejected", "missing-data"]
    },
    "expected_policy_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "customer_name": { "type": "string", "minLength": 3 },
    "customer_id": { "type": "string", "pattern": "^SYN-[0-9]{6}$" },
    "email": { "type": "string", "pattern": ".+@example\\.invalid$" },
    "phone": { "type": "string" },
    "address": { "type": "string" },
    "age_band": { "type": "string" },
    "employer": { "type": "string" },
    "annual_income": { "type": "string" },
    "product": { "type": "string" },
    "facility": {
      "type": "object",
      "required": ["loan_amount", "credit_score"],
      "properties": {
        "loan_amount": { "type": "string" },
        "credit_score": { "type": "string" },
        "property_value": { "type": "string" },
        "ltv": { "type": "string" },
        "dti": { "type": "string" },
        "occupancy": { "type": "string" },
        "tenor_months": { "type": "string" }
      }
    },
    "narrative": { "type": "string", "minLength": 40 },
    "missing_items": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
