{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientApplication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "customer_name",
    "customer_id",
    "email",
    "phone",
    "address",
    "age_band",
    "employer",
    "annual_income",
    "product",
    "facility",
    "narrative",
    "attached_documents"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "pattern": "^CA-[0-9]{4}-[0-9]{6}$"
    },
    "customer_name": { "type": "string", "minLength": 3 },
    "customer_id": { "type": "string", "pattern": "^SYN-[0-9]{6}$" },
    "email": { "type": "string", "pattern": ".+@example\\.invalid$" },
    "phone": { "type": "string" },
    "address": { "type": "string" },
    "age_band": { "type": "string" },
    "employer": { "type": "string" },
    "annual_income": { "type": "string" },
    "product": { "type": "string" },
    "facility": {
      "type": "object",
      "required": ["loan_amount"],
      "properties": {
        "loan_amount": { "type": "string" },
        "credit_score": { "type": "string" },
        "property_value": { "type": "string" },
        "ltv": { "type": "string" },
        "dti": { "type": "string" },
        "dscr": { "type": "string" },
        "occupancy": { "type": "string" },
        "tenor_months": { "type": "string" },
        "years_in_operation": { "type": "string" }
      }
    },
    "narrative": { "type": "string", "minLength": 40 },
    "attached_documents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
